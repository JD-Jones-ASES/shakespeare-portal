---
// Vanilla client script that links the text column and the gloss sidebar two ways.
// No framework: the scene reader is static HTML; this wires clicks + a CustomEvent.
---
<script>
  function clearFocus() {
    document.querySelectorAll('.play-line.line-focused').forEach((el) => el.classList.remove('line-focused'));
  }
  function focusLine(tln: number, scroll: boolean) {
    clearFocus();
    const line = document.getElementById('tln-' + tln);
    if (!line) return;
    line.classList.add('line-focused');
    if (scroll) line.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function flashNote(id: string) {
    const note = document.getElementById('gloss-' + id);
    if (!note) return;
    note.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    note.classList.add('flash');
    window.setTimeout(() => note.classList.remove('flash'), 1200);
  }

  document.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;

    const marker = target.closest('.ann-marker');
    if (marker) {
      const line = marker.closest('.play-line');
      if (line) { clearFocus(); line.classList.add('line-focused'); }
      const id = marker.getAttribute('data-annotation-id');
      if (id) flashNote(id);
      return;
    }

    // Clicking anywhere on an annotated line focuses its first VISIBLE note. In Read mode a
    // line whose only note is scholar/bawdy has its marker hidden (display:none, so
    // offsetParent is null) — treat it as unannotated rather than focus a hidden note.
    const line = target.closest('.play-line[data-has-annotation="true"]');
    if (line) {
      const firstMarker = Array.from(line.querySelectorAll('.ann-marker'))
        .find((m) => (m as HTMLElement).offsetParent !== null);
      if (firstMarker) {
        clearFocus();
        line.classList.add('line-focused');
        const id = firstMarker.getAttribute('data-annotation-id');
        if (id) flashNote(id);
      }
    }
  });

  // Dispatched by the gloss sidebar (React) when a note is clicked.
  window.addEventListener('portal:focus-line', (e) => {
    const detail = (e as CustomEvent<{ tln: number }>).detail;
    if (detail && typeof detail.tln === 'number') focusLine(detail.tln, true);
  });
</script>
