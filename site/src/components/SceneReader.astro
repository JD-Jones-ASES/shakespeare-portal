---
import type { Scene, Annotation, GlossaryEntry } from '../data/types.ts';
import { buildGlossary, glossarize, tidyText } from '../data/glossary.ts';
interface Props {
  scene: Scene;
  annotations: Annotation[];
  speakerColors?: Record<string, string>;
  glossary?: GlossaryEntry[];
  // Subtract from the displayed line number only (not the TLN used for anchoring/ids). Lets a
  // Sonnet scene show lines 1-14 while its TLN stays globally unique. 0 = show the raw TLN.
  lineNumberOffset?: number;
}
const { scene, annotations, speakerColors = {}, glossary = [], lineNumberOffset = 0 } = Astro.props;
const glossLookup = buildGlossary(glossary);

const annsByTln = new Map<number, Annotation[]>();
for (const a of annotations) {
  if (!annsByTln.has(a.tln_start)) annsByTln.set(a.tln_start, []);
  annsByTln.get(a.tln_start)!.push(a);
}

// Show the speaker name only when it changes; continuation lines (and lines after a
// stage direction or blank) leave the name column empty, as in a printed edition.
let _prevSpeaker: string | null = null;
const showSpeaker = scene.lines.map((line) => {
  if (line.kind === 'spoken') {
    // Poems have no speaker (speaker === ''): never render a speaker stripe for them.
    const show = !!line.speaker && line.speaker !== _prevSpeaker;
    _prevSpeaker = line.speaker ?? null;
    return show;
  }
  _prevSpeaker = null;
  return false;
});
---
<ol class="scene-text" start={(scene.lines.find((l) => l.kind === 'spoken')?.tln ?? 1) - lineNumberOffset}>
  {scene.lines.map((line, i) => {
    if (line.kind === 'stage_direction') {
      return (
        <li class="stage-direction" role="note">
          [{(line.stage_directions ?? []).join(' / ')}]
        </li>
      );
    }
    if (line.kind === 'blank') return <li class="blank" aria-hidden="true" />;
    if (line.kind !== 'spoken' || line.tln === undefined) return null;
    const anns = annsByTln.get(line.tln) ?? [];
    // Does this line have a note visible in Read mode? (bawdy_pun / textual_variant /
    // scholar notes are hidden in Read — see GlossSidebar + reader.css.) Drives the
    // dotted underline so a line whose only note is Study-only isn't marked in Read.
    const hasReadNote = anns.some(
      (a) => a.type !== 'bawdy_pun' && a.type !== 'textual_variant' && a.depth !== 'scholar',
    );
    const speakerVar = `--speaker-color: ${speakerColors[line.speaker_id ?? ''] ?? 'transparent'};`;
    return (
      <Fragment>
        {showSpeaker[i] && (
          <li
            class="speaker-row"
            data-speaker-id={line.speaker_id ?? ''}
            style={speakerVar}
          >
            {line.speaker}
          </li>
        )}
        <li
          class="play-line"
          id={`tln-${line.tln}`}
          data-tln={line.tln}
          data-speaker-id={line.speaker_id ?? ''}
          data-has-annotation={anns.length > 0 ? 'true' : 'false'}
          data-ann-basic={hasReadNote ? 'true' : 'false'}
          style={speakerVar}
        >
          <span class="line-number">{line.tln - lineNumberOffset}</span>
          <span class="line-text">{glossarize(tidyText(line.text ?? ''), glossLookup).map((seg) => (seg.t === 'g' ? <span class="gloss-term" tabindex="0" data-def={seg.d}>{seg.v}</span> : seg.v))}</span>
          {anns.length > 0 && (
            <span class="annotation-markers">
              {anns.map((a) => (
                <button
                  type="button"
                  class={`ann-marker ann-${a.type} ann-${a.depth}`}
                  data-annotation-id={a.id}
                  data-anndepth={a.depth}
                  data-anntype={a.type}
                  aria-label={`Show annotation: ${a.summary.slice(0, 60)}`}
                >·</button>
              ))}
            </span>
          )}
        </li>
      </Fragment>
    );
  })}
</ol>
