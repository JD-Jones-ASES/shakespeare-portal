{
  "play": "phoenix_and_the_turtle",
  "title": "The Phoenix and the Turtle",
  "source": {
    "edition": "Project Gutenberg / Open Shakespeare, modern spelling",
    "file": "shakespeare-material-master/texts/gutenberg/phoenix_and_the_turtle_gut.txt",
    "ingested_at": "2026-06-02"
  },
  "acts": [
    {
      "id": "phoenix_and_the_turtle-1",
      "number": 1,
      "title": "The Phoenix and the Turtle",
      "scenes": [
        {
          "id": "phoenix_and_the_turtle-1-1",
          "number": 1,
          "tln_start": 1,
          "tln_end": 67,
          "lines": [
            {
              "kind": "spoken",
              "tln": 1,
              "speaker": "",
              "text": "Let the bird of loudest lay,"
            },
            {
              "kind": "spoken",
              "tln": 2,
              "speaker": "",
              "text": "On the sole Arabian tree,"
            },
            {
              "kind": "spoken",
              "tln": 3,
              "speaker": "",
              "text": "Herald sad and trumpet be,"
            },
            {
              "kind": "spoken",
              "tln": 4,
              "speaker": "",
              "text": "To whose sound chaste wings obey."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 5,
              "speaker": "",
              "text": "But thou, shrieking harbinger,"
            },
            {
              "kind": "spoken",
              "tln": 6,
              "speaker": "",
              "text": "Foul pre-currer of the fiend,"
            },
            {
              "kind": "spoken",
              "tln": 7,
              "speaker": "",
              "text": "Augur of the fever's end,"
            },
            {
              "kind": "spoken",
              "tln": 8,
              "speaker": "",
              "text": "To this troop come thou not near."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 9,
              "speaker": "",
              "text": "From this session interdict"
            },
            {
              "kind": "spoken",
              "tln": 10,
              "speaker": "",
              "text": "Every fowl of tyrant wing,"
            },
            {
              "kind": "spoken",
              "tln": 11,
              "speaker": "",
              "text": "Save the eagle, feather'd king:"
            },
            {
              "kind": "spoken",
              "tln": 12,
              "speaker": "",
              "text": "Keep the obsequy so strict."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 13,
              "speaker": "",
              "text": "Let the priest in surplice white,"
            },
            {
              "kind": "spoken",
              "tln": 14,
              "speaker": "",
              "text": "That defunctive music can,"
            },
            {
              "kind": "spoken",
              "tln": 15,
              "speaker": "",
              "text": "Be the death-defying swan,"
            },
            {
              "kind": "spoken",
              "tln": 16,
              "speaker": "",
              "text": "Lest the requiem lack his right."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 17,
              "speaker": "",
              "text": "And thou, treble-dated crow,"
            },
            {
              "kind": "spoken",
              "tln": 18,
              "speaker": "",
              "text": "That thy sable gender mak'st"
            },
            {
              "kind": "spoken",
              "tln": 19,
              "speaker": "",
              "text": "With the breath thou giv'st and tak'st,"
            },
            {
              "kind": "spoken",
              "tln": 20,
              "speaker": "",
              "text": "'Mongst our mourners shalt thou go."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 21,
              "speaker": "",
              "text": "Here the anthem doth commence:"
            },
            {
              "kind": "spoken",
              "tln": 22,
              "speaker": "",
              "text": "Love and constancy is dead;"
            },
            {
              "kind": "spoken",
              "tln": 23,
              "speaker": "",
              "text": "Phoenix and the turtle fled"
            },
            {
              "kind": "spoken",
              "tln": 24,
              "speaker": "",
              "text": "In a mutual flame from hence."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 25,
              "speaker": "",
              "text": "So they lov'd, as love in twain"
            },
            {
              "kind": "spoken",
              "tln": 26,
              "speaker": "",
              "text": "Had the essence but in one;"
            },
            {
              "kind": "spoken",
              "tln": 27,
              "speaker": "",
              "text": "Two distincts, division none:"
            },
            {
              "kind": "spoken",
              "tln": 28,
              "speaker": "",
              "text": "Number there in love was slain."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 29,
              "speaker": "",
              "text": "Hearts remote, yet not asunder;"
            },
            {
              "kind": "spoken",
              "tln": 30,
              "speaker": "",
              "text": "Distance, and no space was seen"
            },
            {
              "kind": "spoken",
              "tln": 31,
              "speaker": "",
              "text": "'Twixt the turtle and his queen;"
            },
            {
              "kind": "spoken",
              "tln": 32,
              "speaker": "",
              "text": "But in them it were a wonder."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 33,
              "speaker": "",
              "text": "So between them love did shine,"
            },
            {
              "kind": "spoken",
              "tln": 34,
              "speaker": "",
              "text": "That the turtle saw his right"
            },
            {
              "kind": "spoken",
              "tln": 35,
              "speaker": "",
              "text": "Flaming in the phoenix' sight:"
            },
            {
              "kind": "spoken",
              "tln": 36,
              "speaker": "",
              "text": "Either was the other's mine."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 37,
              "speaker": "",
              "text": "Property was thus appall'd,"
            },
            {
              "kind": "spoken",
              "tln": 38,
              "speaker": "",
              "text": "That the self was not the same;"
            },
            {
              "kind": "spoken",
              "tln": 39,
              "speaker": "",
              "text": "Single nature's double name"
            },
            {
              "kind": "spoken",
              "tln": 40,
              "speaker": "",
              "text": "Neither two nor one was call'd."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 41,
              "speaker": "",
              "text": "Reason, in itself confounded,"
            },
            {
              "kind": "spoken",
              "tln": 42,
              "speaker": "",
              "text": "Saw division grow together;"
            },
            {
              "kind": "spoken",
              "tln": 43,
              "speaker": "",
              "text": "To themselves yet either-neither,"
            },
            {
              "kind": "spoken",
              "tln": 44,
              "speaker": "",
              "text": "Simple were so well compounded."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 45,
              "speaker": "",
              "text": "That it cried how true a twain"
            },
            {
              "kind": "spoken",
              "tln": 46,
              "speaker": "",
              "text": "Seemeth this concordant one!"
            },
            {
              "kind": "spoken",
              "tln": 47,
              "speaker": "",
              "text": "Love hath reason, reason none"
            },
            {
              "kind": "spoken",
              "tln": 48,
              "speaker": "",
              "text": "If what parts can so remain."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 49,
              "speaker": "",
              "text": "Whereupon it made this threne"
            },
            {
              "kind": "spoken",
              "tln": 50,
              "speaker": "",
              "text": "To the phoenix and the dove,"
            },
            {
              "kind": "spoken",
              "tln": 51,
              "speaker": "",
              "text": "Co-supreme and stars of love;"
            },
            {
              "kind": "spoken",
              "tln": 52,
              "speaker": "",
              "text": "As chorus to their tragic scene."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "stage_direction",
              "stage_directions": [
                "THRENOS."
              ]
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 53,
              "speaker": "",
              "text": "Beauty, truth, and rarity."
            },
            {
              "kind": "spoken",
              "tln": 54,
              "speaker": "",
              "text": "Grace in all simplicity,"
            },
            {
              "kind": "spoken",
              "tln": 55,
              "speaker": "",
              "text": "Here enclos'd in cinders lie."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 56,
              "speaker": "",
              "text": "Death is now the phoenix' nest;"
            },
            {
              "kind": "spoken",
              "tln": 57,
              "speaker": "",
              "text": "And the turtle's loyal breast"
            },
            {
              "kind": "spoken",
              "tln": 58,
              "speaker": "",
              "text": "To eternity doth rest,"
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 59,
              "speaker": "",
              "text": "Leaving no posterity:--"
            },
            {
              "kind": "spoken",
              "tln": 60,
              "speaker": "",
              "text": "'Twas not their infirmity,"
            },
            {
              "kind": "spoken",
              "tln": 61,
              "speaker": "",
              "text": "It was married chastity."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 62,
              "speaker": "",
              "text": "Truth may seem, but cannot be:"
            },
            {
              "kind": "spoken",
              "tln": 63,
              "speaker": "",
              "text": "Beauty brag, but 'tis not she;"
            },
            {
              "kind": "spoken",
              "tln": 64,
              "speaker": "",
              "text": "Truth and beauty buried be."
            },
            {
              "kind": "blank"
            },
            {
              "kind": "spoken",
              "tln": 65,
              "speaker": "",
              "text": "To this urn let those repair"
            },
            {
              "kind": "spoken",
              "tln": 66,
              "speaker": "",
              "text": "That are either true or fair;"
            },
            {
              "kind": "spoken",
              "tln": 67,
              "speaker": "",
              "text": "For these dead birds sigh a prayer."
            }
          ]
        }
      ]
    }
  ],
  "tln_count": 67
}